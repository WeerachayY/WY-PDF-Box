{
  "name": "WY Pdf Box",
  "short_name": "WY Pdf Box",
  "description": "จัดการไฟล์ PDF — ลบ/สลับ/หมุนหน้า ขีดเขียน ไฮไลต์ เพิ่มข้อความ ประมวลผลในเครื่อง",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F6F7F9",
  "theme_color": "#2563EB",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      },
      "launch_type": "multiple-clients"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "application/pdf",
            ".pdf"
          ]
        }
      ]
    }
  }
}
